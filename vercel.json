{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "trailingSlash": true,
  "rewrites": [
    {
      "source": "/",
      "has": [
        {
          "type": "host",
          "value": "papa-misha.soovita.com"
        }
      ],
      "destination": "/papa-misha/"
    },
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "papa-misha.soovita.com"
        }
      ],
      "destination": "/papa-misha/:path*"
    },
    {
      "source": "/",
      "has": [
        {
          "type": "host",
          "value": "abma-s-farm-market-greenhouse-and-barnya.soovita.com"
        }
      ],
      "destination": "/abma-s-farm-market-greenhouse-and-barnya/"
    },
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "abma-s-farm-market-greenhouse-and-barnya.soovita.com"
        }
      ],
      "destination": "/abma-s-farm-market-greenhouse-and-barnya/:path*"
    },
    {
      "source": "/",
      "has": [
        {
          "type": "host",
          "value": "baras-justini-k-s.soovita.com"
        }
      ],
      "destination": "/baras-justini-k-s/"
    },
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "baras-justini-k-s.soovita.com"
        }
      ],
      "destination": "/baras-justini-k-s/:path*"
    },
    {
      "source": "/",
      "has": [
        {
          "type": "host",
          "value": "k-ht-by-nail-spa.soovita.com"
        }
      ],
      "destination": "/k-ht-by-nail-spa/"
    },
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "k-ht-by-nail-spa.soovita.com"
        }
      ],
      "destination": "/k-ht-by-nail-spa/:path*"
    }
  ],
  "headers": [
    {
      "source": "/:venue/assets/fonts/:path*",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/:venue/assets/video/:path*",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/:venue/assets/img/:path*",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/:venue/vendor/:path*",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/:venue/data/reviews.json",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    }
  ]
}
