{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "trailingSlash": true,
  "rewrites": [
    {
      "source": "/",
      "has": [
        {
          "type": "host",
          "value": "soch-venues.vercel.app"
        }
      ],
      "destination": "/_home/"
    },
    {
      "source": "/",
      "has": [
        {
          "type": "host",
          "value": "papa-misha.soovita.com"
        }
      ],
      "destination": "/papa-misha/"
    },
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "papa-misha.soovita.com"
        }
      ],
      "destination": "/papa-misha/:path*"
    },
